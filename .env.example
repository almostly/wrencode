# Copy to .env and fill in the keys for the backends you want to test.
# wrencode loads .env automatically (real environment variables take precedence).
# .env is gitignored; this example file is safe to commit.

# Pick a default backend (otherwise wrencode prompts / uses ~/.wrencode/config.json)
# BACKEND=anthropic
# MODEL=claude-haiku-4-5-20251001

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Local Anthropic-compatible proxy (BACKEND=local)
# LOCAL_API_KEY=local
# LOCAL_PORT=8082
